APP_NAME=Simba KYC
APP_VERSION=1.0.0
DEBUG=false
EXPOSE_API_DOCS=false
HOST=0.0.0.0
PORT=8001

KYC_ANALYZE_TIMEOUT=30
HEALTH_TIMEOUT=2

USE_LLM_MULTIMODAL=true
LLM_PREFER_PROVIDER=groq
LLM_FALLBACK_CHAIN=["groq"]
LLM_USE_ALL_PROVIDERS=false

GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TIMEOUT=30

LLM_MIN_CONFIDENCE=0.70
LLM_MIN_CONFIDENCE_ID=0.70
LLM_MIN_CONFIDENCE_NAME=0.65
LLM_MIN_CONFIDENCE_DATE=0.75

LIVENESS_PROVIDER=aws
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_LIVENESS_MIN_CONFIDENCE=0.85

API_KEY=
ALLOW_ANONYMOUS=false
ALLOWED_ORIGINS=["*"]
LOG_LEVEL=INFO

DASHBOARD_DATA_DIR=./data
DASHBOARD_ASSET_DIR=
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=Afroza_Solidarity_user
POSTGRES_PASSWORD=Afroza_Solidarity_password
POSTGRES_DB=Afroza_Solidarity_db
